# Gemini API key — set as GEMINI_API_KEY on the Cloudflare Worker (not in Next.js static build)
# Used by POST /api/chat and /api/gemini-chat on kanban-worker

# Optional: override worker URL (defaults to production worker)
# NEXT_PUBLIC_API_URL=https://kanban-worker.sealseapep.workers.dev

# Discord fallback login lives on the Cloudflare Worker.
# Set these as Worker secrets, not in the static frontend build:
# DISCORD_CLIENT_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_SESSION_SECRET=
